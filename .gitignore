# Data (Minecraft server data etc.)
node/dylaris_data/
core/dylaris_data/

# Redis/Valkey ACL runtime state (aclfile created before first boot, rewritten by ACL SAVE)
valkey-acl/

docs/
# Secrets & Configs (IMPORTANT)
.env
config.yaml

# Local test bed: compose overlay that builds from the working tree, and the
# Playwright MCP scratch output. Both are per-developer runtime state.
docker-compose.local.yml
.playwright-mcp/

# build_shipper.sh output: a 9MB Linux ELF staged into the MC image build
# context. Generated, never committed (see /dylaris-core above for why).
docker/mc-server/log-shipper-linux*

# Go & Build (Binaries excluded, but allow dist!)
*.exe
*.test
vendor/
# Extensionless local build outputs (accidentally committed once as
# dylaris-core, a 43MB Linux ELF leaking a dev build path) -- anchored to the
# repo root so it doesn't shadow real subdirectories/files of the same name.
/dylaris-core
dylaris-node
# Same thing for the shipper. It was the one local build output with no rule,
# so it stayed untracked only as long as every `git add` remembered to exclude
# it by hand - and one that ran from a subdirectory (where the pathspec no
# longer matched) committed 9MB of ELF.
dylaris-log-shipper

# Beam desktop app build outputs (rebuilt by CI; not committed). NOTE:
# beam/app/third_party/ (the vendored, BC3-patched Wails) IS committed and must
# NOT be ignored - only these generated outputs are.
beam/app/frontend/dist/
beam/app/build/bin/

# Node (NEVER upload modules)
node_modules/
.next/
# TypeScript incremental build cache — touched every `tsc` run, no reason to version it.
*.tsbuildinfo

# System junk
.vscode/
.idea/
.DS_Store