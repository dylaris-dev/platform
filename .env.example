# ─────────────────────────────────────────────────────────────────────────────
# DYLARIS environment — copy to .env and fill in.
#   cp .env.example .env
# Used by both docker-compose.yml (single host) and docker-stack.yml (swarm).
# A .env file is a local/single-host convenience; in Portainer/Swarm set these
# as stack environment variables instead. There are no CLI flags.
#
# Docker/Portainer secrets: any secret can be read from a file by setting
# <NAME>_FILE to a path (e.g. JWT_SECRET_FILE=/run/secrets/jwt_secret) instead
# of the plain value. Precedence: <NAME>_FILE -> <NAME> -> default. Supported:
# JWT_SECRET, CLUSTER_SECRET, DB_PASSWORD, REDIS_PASSWORD (Core admin only),
# ADMIN_SECRET, BEAM_JWT_SECRET. Nodes and the log-shipper no longer use a static Redis
# password; the node derives scoped Redis creds from its per-node secret.
# ─────────────────────────────────────────────────────────────────────────────

# --- Secrets (REQUIRED — change these) -------------------------------------
# Signing key for panel auth tokens. Use a long random string:
#   openssl rand -hex 32
JWT_SECRET=

# Shared secret authenticating Core <-> Node <-> Link <-> Warp and deriving
# service keys. MUST be identical across every Core and Node in the cluster.
#   openssl rand -hex 32
CLUSTER_SECRET=

# The gateway Hub's internal URL, e.g. http://hub:25530. Only needed when you
# run the gateway: it lets the panel's DNS form reach the Hub, which owns the
# provider credential and is the only writer of records. Leave empty otherwise -
# the DNS card then says there is no gateway instead of offering a dead form.
# The Hub must share this CLUSTER_SECRET; that is what authenticates the hop.
GATEWAY_HUB_URL=

# --- Database (TimescaleDB / PostgreSQL) -----------------------------------
DB_USER=dylaris
DB_PASSWORD=change-me
DB_NAME=dylaris
# Postgres TLS mode. Defaults to "disable" for the bundled in-Docker DB.
# Set to "require" (or "verify-full") when Core connects to a REMOTE Postgres.
# DB_SSLMODE=disable
# Time-series backend for server_stats:
#   timescaledb (default) — hypertable + native retention; best for larger fleets.
#   postgres              — plain table, retention via the hourly sweep; fine for
#                           small/medium setups, needs no TimescaleDB extension.
# DB_TYPE=timescaledb

# Long-term statistics (Settings -> Features -> Long-term statistics; off by
# default). Leave METRICS_DB_URL empty to record HOUR buckets into the Core
# database - a few hundred megabytes a year, works on any Postgres, and what a
# self-hoster gets. Point it at a TimescaleDB instance for MINUTE resolution
# kept indefinitely; the difference is not storage but query cost, since a year
# of minutes is half a billion rows a plain Postgres cannot chunk.
#
# A metrics database that is unreachable is logged and skipped. It never blocks
# Core, and the recorder drops rather than queueing - these are the least
# important bytes in the system.
# METRICS_DB_URL=postgres://dylaris:CHANGEME@metricsdb:5432/dylaris_metrics?sslmode=disable

# --- Redis (coordination bus) ----------------------------------------------
# Core admin Redis login. The bundled Valkey runs the STOCK image (non-root) with
# --aclfile; the aclfile is NOT auto-seeded - create the admin `default` user once
# before the first boot (the exact command is in the redis service comment in
# docker-compose.yml / docker-stack.yml). Its password MUST equal REDIS_PASSWORD.
# Leave empty ONLY for local dev (seed a passwordless `nopass` admin); PRODUCTION
# MUST set it:
#   openssl rand -hex 32
# For a bring-your-own external Redis with a named admin, also set REDIS_USER.
# REDIS_PASSWORD supports the _FILE secret convention (REDIS_PASSWORD_FILE=...).
REDIS_PASSWORD=
# REDIS_USER=default

# Where Core reaches Redis/Valkey. Both shipped compose files already point at
# the bundled "redis" service, so leave this alone for the standard layout; set
# it only when pointing at an external or managed Redis. Nodes are not given
# it: each node is told Core's value when it authenticates, caches it in
# .redis_addr in its storage path, and hands the same address to its Minecraft
# containers and its Link.
# REDIS_ADDR=redis:6379

# --- Frontend / CORS ---------------------------------------------------------
# The externally-reachable Panel URL. Core serves the panel itself, so for
# almost every deployment this is simply Core's own public URL.
#
# It is still needed, and for three things: absolute links in password-reset and
# email-verification emails, the same-site check against TAB_PROXY_HOST_SUFFIX,
# and CORS. There is one host: Core serves the panel and /api together.
#
# Must be reachable from the user's browser -- NOT an internal Docker service
# name (a hardcoded "http://panel:25510" once made every emailed link
# unreachable outside the Docker network).
FRONTEND_URL=http://localhost:25500

# --- Trusted reverse proxies -------------------------------------------------
# Decides when Core believes an X-Forwarded-For header, which the rate limiters
# and the audit log key on. Core takes the client IP as the first hop, walking
# XFF right-to-left, that is NOT one of these networks - so a client's forged
# XFF entry (which sits left of the address your proxy appends) is ignored.
#
# Unset (this default): the private ranges (RFC1918, loopback, IPv6 ULA). The
#   shipped reference proxy sits on the private Docker network, so per-client
#   limiting works out of the box and a public attacker's forged header is not
#   believed. Correct for almost every deployment - leave it unset.
# A CIDR/IP list: trust exactly these, e.g. if your proxy is on a public IP:
#   TRUSTED_PROXY_CIDRS=203.0.113.4,2001:db8::/64
# The value "none": trust nothing and ignore XFF entirely. Correct only when
#   Core is exposed DIRECTLY to clients with no proxy in front.
# TRUSTED_PROXY_CIDRS=

# --- Custom-tab proxy host --------------------------------------------------
# A proxied custom tab shows a server container's own web UI (a map, a
# dashboard). Each one is served at the ROOT of its own hostname:
#
#     <label>.<TAB_PROXY_HOST_SUFFIX>
#
# The root matters. Under a path prefix, a container's own "/js/app.js" is
# resolved against the origin root and misses the prefix - which is exactly what
# BlueMap and Dynmap emit, so neither can be served that way at all. The
# separate hostname is also what keeps a tenant's JavaScript off the panel's
# origin, where it could read the session token out of localStorage.
#
# Empty (the default) means proxied tabs and share links are unavailable.
# Direct tabs, which just point the browser at a URL, are unaffected.
#
# Prerequisites, all three on the operator:
#   1. the suffix must sit on the SAME registrable domain as FRONTEND_URL. The
#      tab ticket cookie is set on the tab host and read back from it, which
#      browsers only allow same-site. share.example.com beside
#      panel.example.com is fine; share.example.net is not. Core says so at
#      startup if they do not match.
#   2. DNS records for BOTH <suffix> and *.<suffix> pointing at your proxy.
#      Create them explicitly even if a catch-all would answer - a catch-all
#      hides a missing record until it fails somewhere else.
#   3. a certificate covering BOTH <suffix> and *.<suffix> - a wildcard does NOT
#      cover its own parent, and wildcards can only be issued over DNS-01. Your
#      router must ASK for it: a bare Host rule gets a certificate per hostname,
#      so every new tab is a fresh issuance and the rate limit arrives quickly.
#
#      Behind Cloudflare these two records must be DNS-only (grey cloud). Free
#      Universal SSL covers example.com and *.example.com - ONE level - so an
#      orange-clouded *.share.example.com fails TLS at Cloudflare's edge before
#      it reaches you.
#
# Worked example with Traefik labels: /docs/reverse-proxy
#
#   TAB_PROXY_HOST_SUFFIX=share.example.com
# TAB_PROXY_HOST_SUFFIX=

# --- Billing lifecycle (BYON) ----------------------------------------------
# Grace before a "suspended" tenant is actually cut off (servers stopped, link
# tunnels dropped), so a transient billing/DB fault cannot instantly kick a
# paying customer. Go duration (e.g. 48h, 24h, 30m). "0" enforces on the next
# hourly tick (no grace). Default 48h.
# BILLING_SUSPEND_GRACE=48h

# --- Panel -----------------------------------------------------------------
# The URL the BROWSER uses to reach the Core API. Include the port AND the /api
# path: Core serves its whole API under /api, and the panel appends route paths
# to this value verbatim (login posts <value>/auth/login). Omitting /api makes
# every call 404 exactly as if the variable were wrong.
#
# LEAVE IT EMPTY. Core serves the panel out of its own binary, so the API is on
# the same origin and the panel finds /api without being told - no CORS, no
# reverse-proxy path rule, nothing to keep in sync. The bundled compose file
# works out of the box on http://localhost:25500.
#
# Set it only if you terminate the API on a DIFFERENT hostname than the panel,
# and only for NON-BROWSER callers. The session is a cookie scoped to the host
# that issued it, so a browser will not carry it across that split: the panel
# loads and every request afterwards answers 401. Core says so at startup when
# it sees the two values disagree.
#
#   PANEL_API_URL=https://api.example.com/api
#
# EMPTY is the answer for every normal deployment, bundled compose included.
PANEL_API_URL=

# --- Region / Node ---------------------------------------------------------
DYLARIS_REGION=default
NODE_ID=node-01
NODE_TAGS=
NODE_REGION=

# Redis-ACL bootstrap (mandatory -- there is no open-Redis fallback). The Node
# needs a reachable Core gRPC endpoint to mint/confirm its per-node secret.
# CORE_GRPC_ADDR is pre-filled for the bundled single-host/stack topology
# (Core's gRPC mesh port, DYLARIS_GRPC_PORT, defaults to 25501); change it only
# for a Node that reaches Core through a different host/port.
CORE_GRPC_ADDR=core:25501
# One-time enroll token (minted in the panel under Settings -> Nodes) that a
# FIRST-boot BYON node presents; it is what binds that node to its tenant.
# NOT needed for a node that holds CLUSTER_SECRET: such a node is in-cluster
# infrastructure and self-enrolls with its cluster proof, so a first deploy
# needs no mint-and-redeploy step. A node with a cached secret ignores this.
NODE_ENROLL_TOKEN=
# Single-use, admin-minted token to re-pair a node under its EXISTING identity
# after its secret was reset (Settings -> Nodes -> Reset pairing). Only needed
# when recovering a node, not on a normal boot.
NODE_RECOVERY_TOKEN=

# Host port range for MC servers in ip_port / both routing modes, as
# "start-end". These are the ports the host firewall has to open, so an
# unusable value is NOT half-applied: the node falls back to 25600-25699 and
# reports why in the panel (Infrastructure -> the node card).
# The former PORT_RANGE_START / PORT_RANGE_END pair is no longer read.
PORT_RANGE=25600-25699

# Routing mode (ip_port | gateway | both) is NOT an env var — it is configured
# at runtime in Settings and stored in Redis (dylaris:routing_mode). The
# optional ingress/proxy stack lives in the separate dylaris-gateway repo.

# Comma-separated hosts the Node may download Core-minted pack-build mrpacks
# from, e.g. app.example.com. Merged into the Node's .mrpack download
# allowlist alongside the built-in hosts (cdn.modrinth.com, github.com, ...).
# MODPACK_MIRROR_HOSTS=

# --- gRPC TLS (Core <-> Node control channel) -------------------------------
# Off by default = plaintext. Rely on an encrypted overlay (WireGuard/VPN)
# between Node and Core, or turn this on. Must be flipped together on every
# Core AND every Node in the cluster (mismatched TLS makes the control channel
# fail to connect; already-running MC servers are unaffected).
# GRPC_TLS_ENABLED=true
# Node-only. Pins the Core control-channel cert fingerprint for a BYON node
# that does NOT hold CLUSTER_SECRET (in-cluster nodes derive the fingerprint
# from CLUSTER_SECRET instead and leave this empty). Public pinning material,
# not a secret; delivered out-of-band at enroll time (panel Settings -> Nodes).
# GRPC_TLS_FINGERPRINT=

# --- Admin break-glass (RAM-only) -------------------------------------------
# Optional. When set (>=16 chars), creating an admin via /setup requires this
# exact value in EVERY mode: it closes the first-boot race on a fresh install
# and re-opens /setup to create a new admin if all admins are lost or to add a
# break-glass admin. Lives ONLY in Core's memory - never written to the DB or
# logs - so removing it and restarting Core deactivates the capability. Also
# supports ADMIN_SECRET_FILE (Docker/Portainer secret). Leave unset to disable.
# ADMIN_SECRET=

# --- Optional: external ticket DB -------------------------------------------
# Surfaces as a migration target in the in-panel DB-migration UI. Live ticket
# queries always hit the main DB regardless of this setting.
# EXTERNAL_TICKET_DB_URL=

# --- Optional: multi-region DNS failover ------------------------------------
# Leader-gated reconciler that points each region's edge wildcard A record at
# the live edge IPs. Only relevant if you run multiple regions behind the
# optional Gateway; most self-hosters leave this unset and set their records by
# hand. Credentials live ONLY in Core, never on edges - an edge is the most
# exposed host in the fleet and a token that can rewrite the zone does not
# belong there.
#
# Backed by libdns, so adding a provider is a constructor entry rather than a
# new HTTP client. DNS_ZONE is the zone NAME (libdns addresses a zone by name),
# which is why it replaces the old Cloudflare-specific CF_ZONE_ID - a zone id
# cannot be carried over. CF_API_TOKEN is still read as a fallback for
# DNS_API_TOKEN, and supports the _FILE secret convention.
#
# All four can also be set in Settings -> Infrastructure -> DNS, where the token
# is stored encrypted. The ENVIRONMENT WINS: setting DNS_API_TOKEN here makes the
# panel field read-only, so a value saved on screen can never silently retire a
# credential you deliberately supplied as a secret. The other fields fall back to
# the panel individually, so you can keep the token in a secret and pick the zone
# on screen.
#
# DNS_ZONES is the multi-zone form (comma-separated) for a hoster offering
# several domains from the same edges. DNS_ZONE stays supported and is folded in,
# so a single-zone deployment needs no change. Names are matched to a zone on a
# label boundary, longest match first.
#
# Deletion is scoped: DYLARIS only ever removes names it created itself, recorded
# in a Redis ownership registry, and only after they have gone unadvertised for
# the grace period (Settings -> DNS, default 15 minutes). A zone you release here
# can safely carry your website and mail records.
# DNS_UPDATER_ENABLED=true
# DNS_PROVIDER=cloudflare
# DNS_API_TOKEN=
# DNS_ZONE=example.com
# DNS_ZONES=example.com,example.org

# --- SaaS-only: dylaris.com store integration -------------------------------
# Service-to-service trust between Core and the hosted dylaris.com storefront
# (store-linking, demo showcase). Leave BOTH unset for a self-host / open-core
# build -- Core then boots with no store or demo surface at all.
# STORE_URL=
# STORE_SHARED_KEY=
